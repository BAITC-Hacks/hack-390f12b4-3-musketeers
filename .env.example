# Copy to .env. The launcher reads this file; never commit real keys.
OPENAI_API_KEY=
# Set to a model available in your API project with Responses + Structured Outputs.
OPENAI_MODEL=
RULESET=dataset-v1
# Only used by the optional two-process run.py / frontend.server setup.
API_BASE_URL=http://127.0.0.1:8000

# Optional shared AI demo code; never put API keys in the browser
DEMO_ACCESS_CODE=
AI_DAILY_LIMIT=100
# Persistent SQLite location (Docker overrides this)
DATABASE_PATH=runtime/city.sqlite3
